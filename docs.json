{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bundly Scripts",
  "colors": {
    "primary": "#80E44F",
    "light": "#80E44F",
    "dark": "#80E44F"
  },
  "favicon": {
    "light": "/images/logo-vector-primary.png",
    "dark": "/images/logo-vector-primary.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo-vector-primary.png",
    "dark": "/images/logo-vector-primary.png"
  },
  "navbar": {
    "primary": {
      "type": "discord",
      "href": "https://discord.gg/CnQcfsw9G"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://bundlyscripts.com",
      "discord": "https://discord.gg/CnQcfsw9G",
      "youtube": "https://youtube.com/@bundlyscripts"
    }
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#000000",
      "dark": "#000000"
    }
  },
  "fonts": {
    "family": "Barlow"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  }
}
